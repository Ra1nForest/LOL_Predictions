# 复制到 /home/ubuntu/lol/service.env 后填值, 然后:
#   chmod 600 /home/ubuntu/lol/service.env
# 这个文件里有密钥, 权限一定要收紧, 也不要提交进 git。

# Stage 3 的 agent 层。不填则 /debate 不可用, 其余端点正常。
NVIDIA_API_KEY=nvapi-

# 检索后端。三选一, websearch.py 按这个顺序探测。
TAVILY_API_KEY=tvly-dev-
# BRAVE_API_KEY=
# SERPER_API_KEY=

# 可选: 给 /debate 加一道口令。
# 设了之后调用 /debate 必须带 header  X-Debate-Key: <值>
# 不设则不校验 (维持现状)。
#
# 为什么只护 /debate: 服务挂在公网 8000 且没有鉴权。/predict 只烧 CPU,
# 被人扫到最多浪费点算力; 但 /debate 一次要打四次 LLM + 若干次检索,
# 是真花钱的端点。护住花钱的那个, 前端用的那些保持开放。
# DEBATE_KEY=

# 让 Python 的输出不被缓冲, journalctl 才能实时看到日志
PYTHONUNBUFFERED=1
